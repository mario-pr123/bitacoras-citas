# Copia este archivo como .env.local para probar en tu computador.
# En Vercel, crea estas mismas variables en Settings → Environment Variables.

# Contraseña para entrar a /admin (solo tú la conoces).
ADMIN_PASSWORD=cambia-esta-contraseña

# Texto largo y aleatorio para firmar la sesión. Si lo cambias, se cierran todas las sesiones.
ADMIN_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Lo agrega Vercel al conectar un Blob store. Si lo dejas vacío en tu computador,
# las citas y fotos se guardan en la carpeta .data/ del proyecto.
BLOB_READ_WRITE_TOKEN=
